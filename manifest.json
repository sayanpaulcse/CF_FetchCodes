{
    "name": "CF FetchCodes",
    "description": "Fetch Accepted Codes & AI Explainer for Codeforces",
    "version": "26.7.9",
    "manifest_version": 3,

    "permissions": [
        "storage",
        "contextMenus"
    ],

    "action": {
        "default_popup": "src/popup/popup.html",
        "default_icon": {
            "128": "assets/icon_128_128.png"
        }
    },

    "icons": {
        "16": "assets/icon16.png",
        "20": "assets/icon20.png",
        "32": "assets/icon32.png",
        "48": "assets/icon48.png",
        "64": "assets/icon64.png",
        "96": "assets/icon_96_96.png",
        "128": "assets/icon_128_128.png"
    },

    "background": {
        "service_worker": "src/background/service-worker.js"
    },

    "host_permissions": [
        "https://codeforces.com/*",
        "https://generativelanguage.googleapis.com/*"
    ],

    "content_scripts": [
        {
            "js": [
                "src/content/modules/constants.js",
                "src/content/modules/utils.js",
                "src/content/modules/chat-manager.js",
                "src/content/modules/api.js",
                "src/content/modules/ui.js",
                "src/content/main.js",
                "src/lib/prettify.js"
            ],
            "css": [
                "src/styles/content.css",
                "src/popup/popup.css",
                "src/lib/prettify.css"
            ],
            "matches": [
                "https://codeforces.com/contest/*/problem/*",
                "https://codeforces.com/problemset/problem/*",
                "https://codeforces.com/gym/*/problem/*"
            ]
        }
    ],

    "web_accessible_resources": [
        {
            "resources": ["assets/*"],
            "matches": ["https://codeforces.com/*"]
        }
    ]
}